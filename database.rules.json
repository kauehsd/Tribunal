{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        ".read": true,
        ".write": "!data.exists() || newData.exists() || data.child('createdAt').val() < now - 604800000",
        ".validate": "$code.length == 4"
      }
    },

    "career": {
      ".read": true,
      "$player": {
        ".write": "newData.exists()"
      }
    },

    "history": {
      "$pair": {
        ".read": true,
        ".write": true
      }
    }
  }
}
